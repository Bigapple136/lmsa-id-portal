# ── Copy this file to .env and fill in your values ──
# Supabase: Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

PORT=4000

# CORS — comma-separated list of allowed origins (empty = allow all for dev)
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Node environment
NODE_ENV=development

# QR signing — keep secret, min 32 chars, e.g. openssl rand -base64 32
QR_SIGNING_SECRET=your-hmac-signing-secret-here

# Frontend URL — used to construct signed preview URLs
FRONTEND_URL=https://your-frontend-url.vercel.app

# Backend URL — used to construct QR scan payloads (Render backend)
BACKEND_URL=https://your-backend-url.onrender.com

# Sentry DSN — optional, for error monitoring
# SENTRY_DSN=https://your-dsn@oXXXX.ingest.us.sentry.io/XXXXX
