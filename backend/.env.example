# ── Copy this file to .env and fill in your values ──
# Supabase: Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

PORT=4000

# CORS — * for local dev; set to your Vercel URL in production
# Example: ALLOWED_ORIGIN=https://your-app.vercel.app
ALLOWED_ORIGIN=*

# Node environment
NODE_ENV=development

# QR signing — keep secret, min 32 chars, e.g. openssl rand -base64 32
QR_SIGNING_SECRET=your-hmac-signing-secret-here

# Frontend URL — used to construct signed preview URLs and QR payloads
FRONTEND_URL=https://your-frontend-url.vercel.app
