# Copy this file to .env and fill in your Supabase values
# Find these in: Supabase → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API base URL — leave empty for local dev (Vite proxy handles it)
# In production set this to your Render backend URL:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# hCaptcha — optional, for admin login brute-force protection
# Sign up at https://www.hcaptcha.com/ to get a site key
# VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Sentry DSN — optional, for error monitoring
# VITE_SENTRY_DSN=https://your-dsn@oXXXX.ingest.us.sentry.io/XXXXX
